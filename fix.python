import json
import re
from database import connect_wp_ozar0

def get_dix_connection():
    return connect_wp_ozar0()

def fix_all_product_attributes():
    """Répare les attributs pour TOUS les produits"""
    conn_dix = get_dix_connection()
    cursor = conn_dix.cursor()
    
    print("🔧 RÉPARATION DES ATTRIBUTS POUR TOUS LES PRODUITS")
    print("=" * 60)
    
    try:
        # 1. Trouver tous les produits avec des attributs pa_*
        cursor.execute("""
            SELECT DISTINCT 
                p.ID as product_id,
                pm.meta_value as sku,
                p.post_title
            FROM 9Ew5q6v_posts p
            JOIN 9Ew5q6v_postmeta pm ON p.ID = pm.post_id AND pm.meta_key = '_sku'
            WHERE p.post_type = 'product'
            AND p.post_status = 'publish'
            AND EXISTS (
                SELECT 1 FROM 9Ew5q6v_term_relationships tr
                JOIN 9Ew5q6v_term_taxonomy tt ON tr.term_taxonomy_id = tt.term_taxonomy_id
                WHERE tr.object_id = p.ID AND tt.taxonomy LIKE 'pa_%'
            )
            ORDER BY p.ID
        """)
        
        products = cursor.fetchall()
        print(f"📊 {len(products)} produits avec attributs à vérifier")
        
        fixed_count = 0
        errors = 0
        
        for product_id, sku, title in products:
            print(f"\n🔄 Produit: {sku or 'N/A'} - {title[:50]}...")
            
            try:
                # 2. Récupérer les termes réels du produit
                cursor.execute("""
                    SELECT 
                        tt.taxonomy,
                        GROUP_CONCAT(t.name SEPARATOR ' | ') as terms
                    FROM 9Ew5q6v_term_relationships tr
                    JOIN 9Ew5q6v_term_taxonomy tt ON tr.term_taxonomy_id = tt.term_taxonomy_id
                    JOIN 9Ew5q6v_terms t ON tt.term_id = t.term_id
                    WHERE tr.object_id = %s
                    AND tt.taxonomy LIKE 'pa_%'
                    GROUP BY tt.taxonomy
                    ORDER BY tt.taxonomy
                """, (product_id,))
                
                real_attributes = cursor.fetchall()
                
                if not real_attributes:
                    print(f"   ⚠️ Aucun attribut pa_* trouvé (étrange)")
                    continue
                
                # 3. Construire le nouveau tableau d'attributs
                product_attrs = {}
                
                for position, (taxonomy, terms_str) in enumerate(real_attributes):
                    attr_name = taxonomy.replace('pa_', '')
                    
                    # Prendre le premier terme (pour les attributs single)
                    term_value = terms_str.split(' | ')[0] if ' | ' in terms_str else terms_str
                    
                    product_attrs[taxonomy] = {
                        'name': attr_name,
                        'value': term_value,
                        'position': position,
                        'is_visible': 1,  # IMPORTANT: visible!
                        'is_variation': 0,
                        'is_taxonomy': 1
                    }
                    
                    print(f"   📌 {attr_name}: {term_value}")
                
                # 4. Sérialiser en format PHP (comme WooCommerce)
                serialized = serialize_php_array(product_attrs)
                
                # 5. Mettre à jour la base
                cursor.execute("""
                    INSERT INTO 9Ew5q6v_postmeta (post_id, meta_key, meta_value)
                    VALUES (%s, '_product_attributes', %s)
                    ON DUPLICATE KEY UPDATE meta_value = %s
                """, (product_id, serialized, serialized))
                
                # 6. Forcer la mise à jour
                cursor.execute("""
                    UPDATE 9Ew5q6v_posts 
                    SET post_modified = NOW(), post_modified_gmt = UTC_TIMESTAMP()
                    WHERE ID = %s
                """, (product_id,))
                
                fixed_count += 1
                
                if fixed_count % 10 == 0:
                    print(f"   ⏳ {fixed_count} produits traités...")
                
            except Exception as e:
                errors += 1
                print(f"   ❌ Erreur: {e}")
        
        conn_dix.commit()
        
        print(f"\n✅ RÉPARATION TERMINÉE")
        print(f"   ✅ Produits réparés: {fixed_count}")
        print(f"   ❌ Erreurs: {errors}")
        
        # Vérification finale
        verify_fix([pid for pid, _, _ in products])
        
    except Exception as e:
        print(f"❌ Erreur globale: {e}")
        conn_dix.rollback()
    finally:
        cursor.close()
        conn_dix.close()

def serialize_php_array(data):
    """Sérialise un tableau Python en format PHP (comme serialize())"""
    def serialize_value(val):
        if isinstance(val, dict):
            items = []
            for k, v in val.items():
                items.append(serialize_value(k) + serialize_value(v))
            return f"a:{len(val)}:{{{"".join(items)}}}"
        elif isinstance(val, int):
            return f"i:{val};"
        elif isinstance(val, str):
            return f"s:{len(val)}:\"{val}\";"
        elif isinstance(val, bool):
            return f"i:{1 if val else 0};"
        else:
            return f"s:{len(str(val))}:\"{str(val)}\";"
    
    return serialize_value(data)

def verify_fix(product_ids):
    """Vérifie que les attributs ont été correctement réparés"""
    conn_dix = get_dix_connection()
    cursor = conn_dix.cursor()
    
    print("\n🔍 VÉRIFICATION POST-RÉPARATION")
    print("=" * 60)
    
    try:
        cursor.execute("""
            SELECT 
                pm.meta_value as sku,
                LENGTH(pm2.meta_value) as attr_length,
                CASE 
                    WHEN pm2.meta_value = 'a:0:{}' THEN '❌ VIDE'
                    WHEN pm2.meta_value LIKE '%s:0:""%' THEN '⚠️ VALEURS VIDES'
                    ELSE '✅ OK'
                END as status,
                SUBSTRING(pm2.meta_value, 1, 100) as preview
            FROM 9Ew5q6v_posts p
            JOIN 9Ew5q6v_postmeta pm ON p.ID = pm.post_id AND pm.meta_key = '_sku'
            LEFT JOIN 9Ew5q6v_postmeta pm2 ON p.ID = pm2.post_id AND pm2.meta_key = '_product_attributes'
            WHERE p.ID IN %s
            ORDER BY p.ID
        """, (tuple(product_ids[:10]),))  # Vérifier les 10 premiers
        
        results = cursor.fetchall()
        
        for sku, length, status, preview in results:
            print(f"{sku}: {status} ({length} chars)")
            if 'VIDE' in status or 'VIDES' in status:
                print(f"   Preview: {preview}")
    
    except Exception as e:
        print(f"❌ Erreur vérification: {e}")
    finally:
        cursor.close()
        conn_dix.close()

def fix_specific_product(sku):
    """Répare les attributs d'un produit spécifique"""
    conn_dix = get_dix_connection()
    cursor = conn_dix.cursor()
    
    try:
        # Trouver le produit
        cursor.execute("""
            SELECT p.ID, p.post_title 
            FROM 9Ew5q6v_posts p
            JOIN 9Ew5q6v_postmeta pm ON p.ID = pm.post_id AND pm.meta_key = '_sku'
            WHERE pm.meta_value = %s
        """, (sku,))
        
        product = cursor.fetchone()
        if not product:
            print(f"❌ Produit {sku} non trouvé")
            return
        
        product_id, title = product
        print(f"🔧 Réparation spécifique: {sku} - {title}")
        
        # Récupérer les termes réels
        cursor.execute("""
            SELECT 
                tt.taxonomy,
                t.name as term_name
            FROM 9Ew5q6v_term_relationships tr
            JOIN 9Ew5q6v_term_taxonomy tt ON tr.term_taxonomy_id = tt.term_taxonomy_id
            JOIN 9Ew5q6v_terms t ON tt.term_id = t.term_id
            WHERE tr.object_id = %s
            AND tt.taxonomy LIKE 'pa_%'
            ORDER BY tt.taxonomy
        """, (product_id,))
        
        attributes = cursor.fetchall()
        
        if not attributes:
            print(f"⚠️ Aucun attribut pa_* trouvé pour {sku}")
            return
        
        # Construire les attributs
        product_attrs = {}
        
        for position, (taxonomy, term_name) in enumerate(attributes):
            attr_name = taxonomy.replace('pa_', '')
            
            product_attrs[taxonomy] = {
                'name': attr_name,
                'value': term_name,
                'position': position,
                'is_visible': 1,
                'is_variation': 0,
                'is_taxonomy': 1
            }
            
            print(f"   ✅ {attr_name}: {term_name}")
        
        # Sérialiser
        serialized = serialize_php_array(product_attrs)
        
        # Mettre à jour
        cursor.execute("""
            INSERT INTO 9Ew5q6v_postmeta (post_id, meta_key, meta_value)
            VALUES (%s, '_product_attributes', %s)
            ON DUPLICATE KEY UPDATE meta_value = %s
        """, (product_id, serialized, serialized))
        
        cursor.execute("""
            UPDATE 9Ew5q6v_posts 
            SET post_modified = NOW(), post_modified_gmt = UTC_TIMESTAMP()
            WHERE ID = %s
        """, (product_id,))
        
        conn_dix.commit()
        print(f"✅ {sku} réparé avec {len(attributes)} attributs")
        
    except Exception as e:
        print(f"❌ Erreur: {e}")
        conn_dix.rollback()
    finally:
        cursor.close()
        conn_dix.close()

if __name__ == "__main__":
    
    
    print("\n2. Réparer B0CG3AS")
    fix_specific_product('B0CG3AS')
    
